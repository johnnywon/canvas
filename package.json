{
  "name": "pulson-canvas",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler pages dev --proxy 5173 --port 8788",
    "dev:all": "concurrently -k -n vite,worker -c cyan,yellow \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc -b && vite build",
    "preview": "wrangler pages dev ./dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "lint": "eslint .",
    "migrations:local": "wrangler d1 migrations apply pulson-canvas-db --local",
    "migrations:remote": "wrangler d1 migrations apply pulson-canvas-db"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@xyflow/react": "^12.4.4",
    "hono": "^4.12.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260506.1",
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "wrangler": "^4.88.0"
  }
}
